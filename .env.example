# Optional: direct delivery. Without these, the site prepares email drafts locally.
# Copy to .env on your server. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# A sender address verified with your email provider.
SMTP_FROM=
# Enable only after an actual privacy review of the hosting and mail setup.
PRIVACY_REVIEWED=false
# Absolute path to a UTF-8 plain-text reviewed privacy notice, outside the public folder.
# This text is served by /api/config and displayed at /privacy.
PRIVACY_NOTICE_PATH=
# Production server port (npm start).
PORT=3000
